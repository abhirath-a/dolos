# Set to 1 for an anonymous, demo-only portfolio deployment.
# DOLOS_DEMO_ONLY=1
# Export these variables into the API process. This file is not auto-loaded.
DOLOS_BIND=127.0.0.1:8000
# Optional model bundle for scoring uploads. Use the bundled weights for synthetic statements.
# DOLOS_MODEL_DIR=dolos/demo_assets/artifacts
# Number of upload and analysis requests the API can process concurrently.
# DOLOS_PROCESSING_LIMIT=4
# Default: free models across providers, without paid-model fallback.
DOLOS_PDF_PROVIDER=openrouter
OPENROUTER_API_KEY=
DOLOS_PDF_MODEL=openrouter/free
DOLOS_PDF_MODE=text
# Upload storage is independent of the database.
DOLOS_STORAGE_BACKEND=local
DOLOS_DATA_DIR=data
# For Cloudflare R2, set DOLOS_STORAGE_BACKEND=r2 on the API.
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=dolos-statements
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PREFIX=dolos
DOLOS_DATABASE_URL=file:./var/dolos.sqlite3
# To use a remote libSQL/Turso database, unset DOLOS_DATABASE_URL above and set:
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
# The API uses SQLite for file URLs and libSQL for remote URLs.
# Optional: set DOLOS_PDF_PROVIDER=openai and a compatible OpenAI model to use OpenAI directly.
# OPENAI_API_KEY=
# Optional bearer authentication for API routes:
DOLOS_API_KEY=
